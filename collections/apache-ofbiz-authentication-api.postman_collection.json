  "item": [
    {
      "id": "708a2388-081c-484e-b5c0-46bd0f06aaa7",
      "name": "Authentication",
      "description": {
        "content": "Obtain and refresh JWT tokens for API access",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "7a486cb7-abca-483d-b1c3-8af72d14d0a2",
          "name": "Apache OFBiz Obtain JWT Access Token",
          "request": {
            "name": "Apache OFBiz Obtain JWT Access Token",
            "description": {
              "content": "Authenticate using HTTP Basic Auth (username/password) to receive a JWT access token and refresh token. The access token must be used as Bearer authentication for all subsequent API calls.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "auth",
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
          "response": [
            {
              "id": "891869de-b5e4-422e-9ce5-c6d70c845eb6",
              "name": "JWT token granted successfully.",
              "originalRequest": {
                "url": {
                  "path": [
                    "auth",
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: basic",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {}
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"statusCode\": 200,\n  \"statusDescription\": \"OK\",\n  \"successMessage\": \"Token granted.\",\n  \"data\": {\n    \"access_token\": \"eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzUxMiJ9.example\",\n    \"token_type\": \"Bearer\",\n    \"expires_in\": \"1800\"\n  }\n}",
